<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mvstudiopro.weixin-channels-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WEIXIN_CHANNELS_REPO_ROOT__/scripts/mvstudiopro-weixin-collector-watchdog.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WEIXIN_CHANNELS_REPO_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/private/tmp/mvstudiopro-weixin-collector-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/mvstudiopro-weixin-collector-watchdog.log</string>
</dict>
</plist>
