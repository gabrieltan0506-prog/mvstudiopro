# 正式域名只发 Vite 前台；API 反代到 Fly。收紧上传体积，避免 CLI 上传被网关掐断。
node_modules
.git
.github
server
# Vite needs these three build-time document import entrypoints.
scripts/*
!scripts/vite-document-import-assets.ts
!scripts/document-import-doc-worker.ts
!scripts/document-import-globals.ts
docs
drizzle
drizzle*
api
tmp
dist
*.log
*.tsbuildinfo
coverage
playwright-report
test-results
.turbo
.cache
Downloads
# 默认忽略大视频，避免 CLI/部署上传爆体积；但 Vite public 下的样片必须进 Vercel，
# 否则首页 /home-assets/*.mp4 与博客 /blog-assets/*.mp4 全站 404。
*.mp4
!client/public/**/*.mp4
*.mov
!client/public/**/*.mov
*.zip
*.tgz
